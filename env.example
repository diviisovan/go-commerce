# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ecommerce

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=4444

# Authentication (JWT)
# REQUIRED. Generate a unique secret per environment, minimum 32 characters:
#   openssl rand -base64 48
# Never commit the real value and never reuse it between dev and production.
JWT_SECRET=replace_me_with_a_long_random_secret_min_32_chars
JWT_ISSUER=go-ecommerce
# Access tokens are short-lived because they cannot be revoked.
JWT_ACCESS_TTL=15m
# Refresh tokens are revocable and rotate on every use.
JWT_REFRESH_TTL=720h
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_DURATION=15m
